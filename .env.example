# Copy to .env locally. Never commit real credentials.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/forgeerp"

# Outgoing email (Nodemailer over SMTP). Leave SMTP_HOST empty to keep email off.
# Credentials stay in the server environment only — never in the database.
SMTP_HOST=""
SMTP_PORT="587"
# true for port 465 (implicit TLS); false for 587 (STARTTLS)
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Your Company <erp@yourcompany.in>"
