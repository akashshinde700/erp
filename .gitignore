# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# local secrets & runtime key material (per-install, never commit)
db/*.key
.env
.env.local
.env.*.local
db/*.db
db/*.db-*

# deploy credentials (per-site SSH passwords) and python cache
deploy_config*.json
__pycache__/

# local audit runtime (throwaway SQLite DB + generated results; never production data)
/tests/erp-test.db
/tests/erp-test.db-*
/tests/audit-results.json

# generated by `next dev` (agentRules); not a source file
AGENTS.md
