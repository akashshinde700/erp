# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (example is safe to commit; all real env files stay local)
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# local secrets & runtime key material (per-install, never commit)
db/*.key
# runtime attachment storage (per-install user files; metadata is in MySQL)
/upload/attachments/
.env
.env.local
.env.*.local
db/*.db
db/*.db-*

# deploy credentials (per-site SSH passwords) and python cache
deploy_config*.json
__pycache__/

# local audit runtime (throwaway SQLite DB + generated results; never production data)
/tests/erp-test.db
/tests/erp-test.db-*
/tests/audit-results.json

# generated by `next dev` (agentRules); not a source file
AGENTS.md

# generated by the test suites
tests/*-results.json
tests/audit-results.json
tests/e2e-artifacts/
perf-results.json

# local-only Prisma generate workaround (this sandbox has no engine download);
# production always runs `prisma generate` from prisma/schema.prisma
/gen-schema.prisma
.gen-schema.prisma
prisma.gen.config.ts

# intermediate frames + render cache (the MP4s themselves are tracked in demo-videos/)
/video-src/frames/
/video-src/work/
/video-src/__pycache__/
